generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Measurement {
  id          Int      @id @default(autoincrement())
  warehouseId String
  countryCode String
  temperature Float
  humidity    Float
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@index([warehouseId])
  @@index([timestamp])
}

enum LotStatus {
  COMPLIANT
  ALERT
  EXPIRED
}

model Lot {
  id          String    @id @default(cuid())
  warehouseId String
  countryCode String
  storageDate DateTime
  status      LotStatus @default(COMPLIANT)
  createdAt   DateTime  @default(now())

  @@index([storageDate])
  @@index([warehouseId])
}

enum AlertType {
  TEMPERATURE
  HUMIDITY
  LOT_EXPIRED
}

model Alert {
  id            String    @id @default(cuid())
  warehouseId   String
  countryCode   String
  type          AlertType
  message       String
  measuredValue Float
  minAllowed    Float
  maxAllowed    Float
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  lotId         String? // renseigné uniquement pour les alertes LOT_EXPIRED

  // Index composite pour la recherche d'alertes actives (resolvedAt IS NULL)
  @@index([warehouseId, type, resolvedAt])
  @@index([lotId, type])
}
