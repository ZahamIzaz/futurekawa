# Développement local uniquement
# En Docker, ces variables sont injectées par docker-compose

DATABASE_URL="postgresql://futurekawa:futurekawa_secret@localhost:5432/futurekawa_country"
MQTT_BROKER_URL="mqtt://localhost:1883"
PORT=3001

# SMTP (MailHog en local via Docker : port 1025 exposé sur localhost)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=alerts@futurekawa.local
BRAZIL_MANAGER_EMAIL=responsable.bresil@futurekawa.local
