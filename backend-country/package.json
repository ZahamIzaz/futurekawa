{
  "name": "futurekawa-backend-country",
  "version": "1.0.0",
  "description": "Backend pays FutureKawa – API REST + consumer MQTT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
